{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid == $uid || auth.token.email == 'wube8816@gmail.com')"
      }
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid == $uid || auth.token.email == 'wube8816@gmail.com')"
      }
    },
    "messages": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["timestamp"],
      "$messageId": {
        ".validate": "newData.hasChildren(['text', 'uid', 'name']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length < 500"
      }
    },
    "quizScores": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email == 'wube8816@gmail.com'",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "admin": {
      "kicklist": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && (auth.token.email == 'wube8816@gmail.com' || auth.uid == $uid)"
        }
      },
      "globalView": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email == 'wube8816@gmail.com'"
      },
      "quizState": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email == 'wube8816@gmail.com'"
      },
      "currentQuizData": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email == 'wube8816@gmail.com'"
      },
      "kbcState": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email == 'wube8816@gmail.com'",
        "players": {
          "$uid": {
            "submitted": {
              ".write": "auth != null && auth.uid == $uid"
            }
          }
        }
      },
      "surveys": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email == 'wube8816@gmail.com'"
      },
      "surveyState": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email == 'wube8816@gmail.com'",
        "submissions": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid"
          }
        }
      },
      "ideaSurveys": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email == 'wube8816@gmail.com'"
      },
      "ideaState": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email == 'wube8816@gmail.com'",
        "ideas": {
          ".read": "auth != null",
          ".write": "auth != null",
          "$ideaId": {
            ".write": "auth != null",
            "voters": {
              "$uid": {
                ".write": "auth != null && auth.uid == $uid"
              }
            }
          }
        }
      }
    }
  }
}
