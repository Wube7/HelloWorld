{
  "rules": {
    "systemConfig": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email == 'wube@google.com'"
    },
    "rooms": {
      ".read": "auth != null",
      "$roomId": {
        // Anyone logged in can read the metadata, but writing is restricted
        "metadata": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || data.child('creatorUid').val() == auth.uid || auth.token.email == 'wube@google.com')"
        },
        "state": {
          // Only the room creator (admin) or super admin can write/modify the active state
          ".read": "auth != null",
          ".write": "auth != null && (data.parent().child('metadata').child('creatorUid').val() == auth.uid || auth.token.email == 'wube@google.com')",
          
          // Exception: Players submit their own answers
          "kbcState": {
            "players": {
              "$uid": {
                "submitted": {
                  ".write": "auth != null && auth.uid == $uid"
                }
              }
            }
          },
          "surveyState": {
            "submissions": {
              "$uid": {
                ".write": "auth != null && auth.uid == $uid"
              }
            }
          },
          "ideaState": {
            "ideas": {
              "$ideaId": {
                ".write": "auth != null",
                "voters": {
                  "$uid": {
                    ".write": "auth != null && auth.uid == $uid"
                  }
                }
              }
            }
          },
          "equationsState": {
            "players": {
              "$uid": {
                "solved": {
                  ".write": "auth != null && auth.uid == $uid"
                }
              }
            }
          }
        },
        "presence": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && (auth.uid == $uid || data.parent().parent().child('metadata').child('creatorUid').val() == auth.uid || auth.token.email == 'wube@google.com')"
          }
        },
        "kicklist": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && (data.parent().parent().child('metadata').child('creatorUid').val() == auth.uid || auth.token.email == 'wube@google.com' || auth.uid == $uid)"
          }
        },
        "messages": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".indexOn": ["timestamp"],
          "$messageId": {
            ".validate": "newData.hasChildren(['text', 'uid', 'name']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length < 500"
          }
        },
        "quizScores": {
          ".read": "auth != null",
          ".write": "auth != null && (data.parent().child('metadata').child('creatorUid').val() == auth.uid || auth.token.email == 'wube@google.com')",
          "$uid": {
            ".write": "auth != null && auth.uid == $uid"
          }
        }
      }
    },
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid == $uid || auth.token.email == 'wube@google.com')"
      }
    }
  }
}
